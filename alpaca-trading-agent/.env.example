# ═══════════════════════════════════════════════════════════════
# Alpaca AI Trading Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Alpaca Paper Trading API ──────────────────────────────────
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
# 1. Create a free paper trading account
# 2. Generate API keys from the dashboard
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# ── Anthropic (Claude) — Primary AI ─────────────────────────────────
# Get this from: https://console.anthropic.com
# Used for the primary AI decision engine and chat interface.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Gemini — Fallback AI ──────────────────────────────────────
# Get this from: https://aistudio.google.com/app/apikey (free, no credit card)
# Used as fallback when Anthropic credits run out (HTTP 402) or rate limit
# hits (HTTP 429). Leave blank to disable Gemini fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Alpaca MCP Server ─────────────────────────────────────────
# The MCP server is run via `uvx alpaca-mcp-server`.
# These are passed to the MCP subprocess as env vars.
# Toolset filtering (optional): comma-separated list to restrict tools.
# Available toolsets: account, orders, positions, market_data_stock,
#   market_data_options, market_data_crypto, watchlists, portfolio,
#   calendar, assets, docs
# ALPACA_TOOLSETS=account,orders,positions,market_data_stock,portfolio

# ── Strategy Configuration ────────────────────────────────────
STRATEGY_NAME=pairs_trading
# Pairs trading defaults
STRATEGY_SYMBOL_A=SPY
STRATEGY_SYMBOL_B=QQQ
STRATEGY_LOOKBACK_PERIOD=20
STRATEGY_ENTRY_ZSCORE=2.0
STRATEGY_EXIT_ZSCORE=0.5
STRATEGY_POSITION_SIZE_PCT=0.10

# ── Server Configuration ──────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Frontend (Vite dev server) ────────────────────────────────
VITE_API_URL=http://localhost:8000
